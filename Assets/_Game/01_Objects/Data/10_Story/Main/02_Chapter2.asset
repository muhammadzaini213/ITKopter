  m_EditorClassIdentifier: Assembly-CSharp::StoryData
  storyId: story_main_02
  storyName: Welcome to the Chaos
  storyDescription: Abstract landscapes, bizarre creatures, and nobody seems concerned.
  chapterLabel: CHAPTER 2
  previousStory: {fileID: 11400000, guid: 1dfb5eff8c92c56219bc0f921d9b8c4a, type: 2}
  requiredLevel: {fileID: 0}
  storyPrefab: {fileID: 0}
  segments:
  - type: 0
    lines:
    - style: 1
      speaker: {fileID: 0}
      speakerName: 
      rightSide: 0
      label: 
      heading: 
      text: Fajar slowly opens his eyes. He is standing in a strange environment.
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 1
      speaker: {fileID: 0}
      speakerName: 
      rightSide: 0
      label: 
      heading: 
      text: The landscape stretches in directions that don't seem to make sense.
        The ground is covered in abstract patterns, and the sky has an unfamiliar
        color.
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 1
      speaker: {fileID: 0}
      speakerName: 
      rightSide: 0
      label: 
      heading: 
      text: One Concept Spirit is being chased by several others. Another throws
        projectiles at someone who seems completely uninterested. Two more are arguing,
        and their argument has somehow turned into a bullet-hell fight.
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 1
      speaker: {fileID: 0}
      speakerName: 
      rightSide: 0
      label: 
      heading: 
      text: Nobody seems particularly concerned.
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 0}
      speakerName: Fajar
      rightSide: 0
      label: 
      heading: 
      text: ...
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 0}
      speakerName: Fajar
      rightSide: 0
      label: 
      heading: 
      text: What?
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 1
      speaker: {fileID: 0}
      speakerName: 
      rightSide: 0
      label: 
      heading: 
      text: A small creature passes by, carrying something that resembles a giant
        pencil.
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 0}
      speakerName: Fajar
      rightSide: 0
      label: 
      heading: 
      text: Is that... a person?
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 1
      speaker: {fileID: 0}
      speakerName: 
      rightSide: 0
      label: 
      heading: 
      text: The creature disappears behind a strange structure.
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 0}
      speakerName: Fajar
      rightSide: 0
      label: 
      heading: 
      text: No. Never mind.
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 0}
      speakerName: Spirit A
      rightSide: 0
      label: 
      heading: 
      text: YOU TOOK IT!
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 0}
      speakerName: Spirit B
      rightSide: 1
      label: 
      heading: 
      text: I DIDN'T TAKE ANYTHING!
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 1
      speaker: {fileID: 0}
      speakerName: 
      rightSide: 0
      label: 
      heading: 
      text: A projectile flies past Fajar.
      blackScreen: 0
      background: {fileID: 0}
      effect: 2
    - style: 0
      speaker: {fileID: 0}
      speakerName: Fajar
      rightSide: 0
      label: 
      heading: 
      text: Okay. Nope.
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 1
      speaker: {fileID: 0}
      speakerName: 
      rightSide: 0
      label: 
      heading: 
      text: Another projectile hits the ground nearby.
      blackScreen: 0
      background: {fileID: 0}
      effect: 2
    - style: 0
      speaker: {fileID: 0}
      speakerName: Fajar
      rightSide: 0
      label: 
      heading: 
      text: WHAT WAS THAT?!
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 0}
      speakerName: Fajar
      rightSide: 0
      label: 
      heading: 
      text: Are they seriously fighting with projectiles?!
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 1
      speaker: {fileID: 0}
      speakerName: 
      rightSide: 0
      label: 
      heading: 
      text: The surrounding Concept Spirits carry on as if nothing unusual is happening.
        Some walk past the fight. Others watch for a moment, then go back to what
        they were doing.
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 1
      speaker: {fileID: 0}
      speakerName: 
      rightSide: 0
      label: 
      heading: 
      text: Fajar takes a few steps backward.
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 0}
      speakerName: Fajar
      rightSide: 0
      label: 
      heading: 
      text: I shouldn't have clicked that button.
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 0}
      speakerName: Fajar
      rightSide: 0
      label: 
      heading: 
      text: Phone? Gone.
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 0}
      speakerName: Fajar
      rightSide: 0
      label: 
      heading: 
      text: Wallet? Gone.
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 0}
      speakerName: Fajar
      rightSide: 0
      label: 
      heading: 
      text: Great. No phone, no internet, no familiar landmarks...
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 1
      speaker: {fileID: 0}
      speakerName: 
      rightSide: 0
      label: 
      heading: 
      text: A nearby Spirit suddenly crashes into the ground.
      blackScreen: 0
      background: {fileID: 0}
      effect: 2
    - style: 0
      speaker: {fileID: 0}
      speakerName: Fajar
      rightSide: 0
      label: 
      heading: 
      text: And apparently, no safety regulations.
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 1
      speaker: {fileID: 0}
      speakerName: 
      rightSide: 0
      label: 
      heading: 
      text: Fajar walks toward what looks like a path. After several minutes, he
        realizes the scenery doesn't change in any predictable way.
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 0}
      speakerName: Fajar
      rightSide: 0
      label: 
      heading: 
      text: ...Wait.
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 0}
      speakerName: Fajar
      rightSide: 0
      label: 
      heading: 
      text: Didn't I just pass this place?
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 0}
      speakerName: Fajar
      rightSide: 0
      label: 
      heading: 
      text: Okay. That's not good.
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 0}
      speakerName: ???
      rightSide: 1
      label: 
      heading: 
      text: HEEEEEEEEEEEEY!!!
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 0}
      speakerName: Fajar
      rightSide: 0
      label: 
      heading: 
      text: ...Oh, great.
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    level: {fileID: 0}
    team: []
    scriptedLoss: 0
