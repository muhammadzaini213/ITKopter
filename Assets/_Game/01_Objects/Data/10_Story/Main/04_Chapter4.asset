    - time: 1.5
      speaker: {fileID: 11400000, guid: f030c5b604997dacfaea867d37529fce, type: 2}
      speakerName: 
      text: Press 1 or 2 to switch who is on the field, Your Majesty. Switching has
        a short cooldown.
      duration: 4.5
    - time: 9
      speaker: {fileID: 11400000, guid: f030c5b604997dacfaea867d37529fce, type: 2}
      speakerName: 
      text: 'Switch to me and press K. My EX skill marks the enemies: the whole party
        deals more damage to them.'
      duration: 4.5
    - time: 18
      speaker: {fileID: 11400000, guid: f030c5b604997dacfaea867d37529fce, type: 2}
      speakerName: 
      text: Defeat a marked enemy and the party recovers some health. Then switch
        back to Ei-Pi.
      duration: 4.5
    - time: 30
      speaker: {fileID: 11400000, guid: e5a4c2003775679f7b6197557d77e1fb, type: 2}
      speakerName: 
      text: TEAMWORK!!! I'M THE LOUD PART!!!
      duration: 4.5
    - time: 44
      speaker: {fileID: 11400000, guid: c56d01f7147e2fe3bb19ffecd321267b, type: 2}
      speakerName: 
      text: WHY IS IT ALWAYS ME?!
      duration: 4.5
  - type: 0
    lines:
    - style: 1
      speaker: {fileID: 0}
      speakerName: 
      rightSide: 0
      label: 
      heading: 
      text: Anon is defeated again.
      blackScreen: 0
      effect: 0
    - style: 0
