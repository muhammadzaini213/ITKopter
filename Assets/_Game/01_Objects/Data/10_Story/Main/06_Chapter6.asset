    battleToasts:
    - time: 2
      speaker: {fileID: 11400000, guid: f030c5b604997dacfaea867d37529fce, type: 2}
      speakerName: 
      text: 'Hierarchies counter each other: Abstract beats Simple, Simple beats
        Special, Special beats Abstract.'
      duration: 5.5
    - time: 10
      speaker: {fileID: 11400000, guid: f030c5b604997dacfaea867d37529fce, type: 2}
      speakerName: 
      text: Warlock and I are Abstract. Tren and Cashino are Simple. Hit them with
        us for double damage.
      duration: 5.5
    - time: 19
      speaker: {fileID: 11400000, guid: f030c5b604997dacfaea867d37529fce, type: 2}
      speakerName: 
      text: Bokusu is Simple and Trady is Abstract. Keep him off her; his attacks
        barely scratch her.
      duration: 5.5
    - time: 30
      speaker: {fileID: 11400000, guid: c3e64c97bdf51dc37bfd93cf40728166, type: 2}
      speakerName: 
      text: COME ON!!! HIT ME HARDER!!!
      duration: 4.5
    - time: 36
      speaker: {fileID: 11400000, guid: 2427568e74d898eb2a009073ab81c9c4, type: 2}
      speakerName: 
      text: Please stop encouraging them.
      duration: 4.5
    - time: 44
      speaker: {fileID: 11400000, guid: f030c5b604997dacfaea867d37529fce, type: 2}
      speakerName: 
      text: Focus on their weaknesses. That's the important part.
      duration: 4.5
  - type: 0
    lines:
    - style: 1
      speaker: {fileID: 0}
      speakerName: 
      rightSide: 0
      label: 
      heading: 
      text: Tren, Trady and Cashino fall back.
      blackScreen: 0
      effect: 0
    - style: 0
