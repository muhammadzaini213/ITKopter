    scriptedLoss: 0
    scriptedLossSeconds: 45
    battleToasts: []
  - type: 1
    lines: []
    level: {fileID: 11400000, guid: 4f7994c475646cde1abba1cc20343061, type: 2}
    team:
    - {fileID: 11400000, guid: c3e64c97bdf51dc37bfd93cf40728166, type: 2}
    - {fileID: 11400000, guid: f030c5b604997dacfaea867d37529fce, type: 2}
    - {fileID: 11400000, guid: 2427568e74d898eb2a009073ab81c9c4, type: 2}
    scriptedLoss: 0
    scriptedLossSeconds: 45
    battleToasts:
    - time: 2
      trigger: 0
      notBefore: 0
      speaker: {fileID: 11400000, guid: f030c5b604997dacfaea867d37529fce, type: 2}
      speakerName: 
      text: Abstract > Simple > Special > Abstract.
      duration: 4.5
    - time: 10
      trigger: 0
      notBefore: 0
      speaker: {fileID: 11400000, guid: f030c5b604997dacfaea867d37529fce, type: 2}
      speakerName: 
      text: Warlock and I are Abstract. Tren and Cashino are Simple. Use that advantage!
      duration: 4.5
    - time: 19
      trigger: 0
      notBefore: 0
      speaker: {fileID: 11400000, guid: f030c5b604997dacfaea867d37529fce, type: 2}
      speakerName: 
      text: Bokusu is Simple, while Trady is Abstract. Be careful when switching
        to him!
      duration: 4.5
    - time: 26
      trigger: 0
      notBefore: 0
      speaker: {fileID: 11400000, guid: f030c5b604997dacfaea867d37529fce, type: 2}
      speakerName: 
      text: Switching at the right moment can trigger a Perfect Switch!
      duration: 4.5
    - time: 32
      trigger: 0
      notBefore: 0
      speaker: {fileID: 11400000, guid: f030c5b604997dacfaea867d37529fce, type: 2}
      speakerName: 
      text: Tag in someone whose hierarchy counters the enemies for a Counter Tag-In!
      duration: 4.5
    - time: 39
      trigger: 0
      notBefore: 0
      speaker: {fileID: 11400000, guid: c3e64c97bdf51dc37bfd93cf40728166, type: 2}
      speakerName: 
      text: COME ON!!! HIT ME HARDER!!!
      duration: 4.5
    - time: 44
      trigger: 0
      notBefore: 0
      speaker: {fileID: 11400000, guid: 2427568e74d898eb2a009073ab81c9c4, type: 2}
      speakerName: 
      text: Please stop encouraging them.
      duration: 4.5
    - time: 50
      trigger: 0
      notBefore: 0
      speaker: {fileID: 11400000, guid: f030c5b604997dacfaea867d37529fce, type: 2}
      speakerName: 
      text: Remember to use your party's advantages, not just their damage!
      duration: 4.5
    - time: 0
      trigger: 1
      notBefore: 28
      speaker: {fileID: 11400000, guid: f030c5b604997dacfaea867d37529fce, type: 2}
      speakerName: 
      text: Now! Switch!
      duration: 2.5
    - time: 0
      trigger: 2
      notBefore: 0
      speaker: {fileID: 11400000, guid: f030c5b604997dacfaea867d37529fce, type: 2}
      speakerName: 
      text: Excellent! That's a Perfect Switch!
      duration: 4.5
    - time: 3
      trigger: 2
      notBefore: 0
      speaker: {fileID: 11400000, guid: c3e64c97bdf51dc37bfd93cf40728166, type: 2}
      speakerName: 
      text: THAT'S IT!!! KEEP IT COMING!!!
      duration: 4.5
    - time: 6
      trigger: 2
      notBefore: 0
      speaker: {fileID: 11400000, guid: 2427568e74d898eb2a009073ab81c9c4, type: 2}
      speakerName: 
      text: Please stop encouraging them.
      duration: 4.5
    - time: 0
      trigger: 4
      notBefore: 0
      speaker: {fileID: 11400000, guid: f030c5b604997dacfaea867d37529fce, type: 2}
      speakerName: 
      text: Your Switching Window is ready. Use it to bring your entire party into
        the battlefield!
      duration: 4.5
    - time: 0
      trigger: 5
      notBefore: 0
      speaker: {fileID: 11400000, guid: f030c5b604997dacfaea867d37529fce, type: 2}
      speakerName: 
      text: All three characters can attack during this window. But remember, they
        can also receive damage!
      duration: 4.5
    - time: 3
      trigger: 5
      notBefore: 0
      speaker: {fileID: 11400000, guid: c3e64c97bdf51dc37bfd93cf40728166, type: 2}
      speakerName: 
      text: NOW THIS IS A REAL FIGHT!!!
      duration: 4.5
    - time: 6
      trigger: 5
      notBefore: 0
      speaker: {fileID: 11400000, guid: 2427568e74d898eb2a009073ab81c9c4, type: 2}
      speakerName: 
      text: Everyone, please be careful!
      duration: 4.5
    - time: 9
      trigger: 5
      notBefore: 0
      speaker: {fileID: 11400000, guid: e5a4c2003775679f7b6197557d77e1fb, type: 2}
      speakerName: 
      text: WAIT!!! WHY AM I NOT IN THIS FIGHT?!
      duration: 4.5
    - time: 12
      trigger: 5
      notBefore: 0
      speaker: {fileID: 0}
      speakerName: Fajar
      text: ...I can hear you from here.
      duration: 4.5
  - type: 0
    lines:
    - style: 1
      speaker: {fileID: 0}
      speakerName: 
      rightSide: 0
      label: 
      heading: 
      text: The opponents retreat.
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 11400000, guid: c3e64c97bdf51dc37bfd93cf40728166, type: 2}
      speakerName: 
      rightSide: 0
      label: 
      heading: 
      text: THAT WAS GREAT! LET'S DO IT AGAIN SOMETIME!
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 0}
      speakerName: Fajar
      rightSide: 0
      label: 
      heading: 
      text: I'd rather not.
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 11400000, guid: f030c5b604997dacfaea867d37529fce, type: 2}
      speakerName: 
      rightSide: 0
      label: 
      heading: 
      text: You handled that well, Your Majesty.
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 0}
      speakerName: Fajar
      rightSide: 0
      label: 
      heading: 
      text: I think I'm starting to understand how this works.
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 11400000, guid: c3e64c97bdf51dc37bfd93cf40728166, type: 2}
      speakerName: 
      rightSide: 0
      label: 
      heading: 
      text: YOU KNOW WHAT? I LIKE YOU!
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 0}
      speakerName: Fajar
      rightSide: 0
      label: 
      heading: 
      text: ...Thanks?
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 11400000, guid: c3e64c97bdf51dc37bfd93cf40728166, type: 2}
      speakerName: 
      rightSide: 0
      label: 
      heading: 
      text: I'LL BE SEEING YOU AROUND!
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 1
      speaker: {fileID: 0}
      speakerName: 
      rightSide: 0
      label: 
      heading: 
      text: Warlock leaves.
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 11400000, guid: 2427568e74d898eb2a009073ab81c9c4, type: 2}
      speakerName: 
      rightSide: 0
      label: 
      heading: 
      text: That was... quite an experience.
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 0}
      speakerName: Fajar
      rightSide: 0
      label: 
      heading: 
      text: Is he always like that?
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 11400000, guid: f030c5b604997dacfaea867d37529fce, type: 2}
      speakerName: 
      rightSide: 0
      label: 
      heading: 
      text: I'm afraid so.
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 1
      speaker: {fileID: 0}
      speakerName: 
      rightSide: 0
      label: 
      heading: 
      text: A brief silence.
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 0}
      speakerName: Fajar
      rightSide: 0
      label: 
      heading: 
      text: There's something else I've been wondering.
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 11400000, guid: f030c5b604997dacfaea867d37529fce, type: 2}
      speakerName: 
      rightSide: 0
      label: 
      heading: 
      text: Yes?
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 0}
      speakerName: Fajar
      rightSide: 0
      label: 
      heading: 
      text: Everyone keeps calling me King. But I haven't really done anything that
        makes me feel like one.
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 11400000, guid: f030c5b604997dacfaea867d37529fce, type: 2}
      speakerName: 
      rightSide: 0
      label: 
      heading: 
      text: Your authority is different from that of ordinary Concept Spirits.
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 0}
      speakerName: Fajar
      rightSide: 0
      label: 
      heading: 
      text: Different how?
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 11400000, guid: f030c5b604997dacfaea867d37529fce, type: 2}
      speakerName: 
      rightSide: 0
      label: 
      heading: 
      text: You are the King of All Concepts. Your power is not limited to fighting
        through ordinary Concept Spirits.
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 0}
      speakerName: Fajar
      rightSide: 0
      label: 
      heading: 
      text: So I can fight too?
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 11400000, guid: f030c5b604997dacfaea867d37529fce, type: 2}
      speakerName: 
      rightSide: 0
      label: 
      heading: 
      text: You can manifest your authority directly.
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 0}
      speakerName: Fajar
      rightSide: 0
      label: 
      heading: 
      text: How?
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 11400000, guid: f030c5b604997dacfaea867d37529fce, type: 2}
      speakerName: 
      rightSide: 0
      label: 
      heading: 
      text: When your Annihilator gauge is full, you can manifest yourself for a
        short period.
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 0}
      speakerName: Fajar
      rightSide: 0
      label: 
      heading: 
      text: ...Myself?
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 11400000, guid: f030c5b604997dacfaea867d37529fce, type: 2}
      speakerName: 
      rightSide: 0
      label: 
      heading: 
      text: Your manifestation is temporary, but its power is far beyond that of
        a normal Concept Spirit.
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 0}
      speakerName: Fajar
      rightSide: 0
      label: 
      heading: 
      text: And what happens when I manifest?
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 11400000, guid: f030c5b604997dacfaea867d37529fce, type: 2}
      speakerName: 
      rightSide: 0
      label: 
      heading: 
      text: Your party will leave the battlefield temporarily. You will enter in
        their place and unleash an attack based on the hierarchy you select.
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 0}
      speakerName: Fajar
      rightSide: 0
      label: 
      heading: 
      text: That sounds dangerous.
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 11400000, guid: f030c5b604997dacfaea867d37529fce, type: 2}
      speakerName: 
      rightSide: 0
      label: 
      heading: 
      text: It is a considerable power. Use it carefully.
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    level: {fileID: 0}
