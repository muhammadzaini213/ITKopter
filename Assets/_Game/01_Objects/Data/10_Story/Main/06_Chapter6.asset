      speakerName: Fajar
      rightSide: 0
      label: 
      heading: 
      text: ...So that's what it feels like.
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 11400000, guid: f030c5b604997dacfaea867d37529fce, type: 2}
