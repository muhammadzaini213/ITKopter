  m_Script: {fileID: 11500000, guid: 4877fb6ffc62fe90d83c8e4d3d4cb55f, type: 3}
  m_Name: 14_Chapter14
  m_EditorClassIdentifier: Assembly-CSharp::StoryData
  storyId: story_main_14
  storyName: Everyone Wants a Piece of Her
  storyDescription: 'EyaY becomes the center of attention. Battles: Regu against
    EyaY, Warlock and Anon.'
  chapterLabel: CHAPTER 14
  previousStory: {fileID: 11400000, guid: 5c7cfa35f60200cfcba96c829ce7c79f, type: 2}
  requiredLevel: {fileID: 11400000, guid: 25717c376580b292b9cfcacabf46933c, type: 2}
  storyPrefab: {fileID: 0}
  segments:
  - type: 0
    lines:
    - style: 3
      speaker: {fileID: 0}
      speakerName: 
      rightSide: 0
      label: CONCEPT WORLD
      heading: NEON CITY
      text: 
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 1
      speaker: {fileID: 0}
      speakerName: 
      rightSide: 0
      label: 
      heading: 
      text: EyaY walks through Neon City, looking around curiously. Her cyan holographic
        panels float gently around her, occasionally displaying unfamiliar symbols.
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 11400000, guid: e6d914e1b91a42b51a008c5b6d584b65, type: 2}
      speakerName: 
      rightSide: 0
      label: 
      heading: 
      text: Wow... there are so many things here.
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 1
      speaker: {fileID: 0}
      speakerName: 
      rightSide: 0
      label: 
      heading: 
      text: She stops in front of a large screen displaying various abstract patterns.
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 11400000, guid: e6d914e1b91a42b51a008c5b6d584b65, type: 2}
      speakerName: 
      rightSide: 0
      label: 
      heading: 
      text: I wonder what this place is...
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 11400000, guid: 861c91e0066ee5902b97918f4a0a639a, type: 2}
      speakerName: 
      rightSide: 1
      label: 
      heading: 
      text: HEY! THERE YOU ARE!
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 11400000, guid: e6d914e1b91a42b51a008c5b6d584b65, type: 2}
      speakerName: 
      rightSide: 0
      label: 
      heading: 
      text: Oh! Hello!
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 11400000, guid: 861c91e0066ee5902b97918f4a0a639a, type: 2}
      speakerName: 
      rightSide: 1
      label: 
      heading: 
      text: YOU'RE THE ONE EVERYONE'S TALKING ABOUT, RIGHT?!
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 11400000, guid: e6d914e1b91a42b51a008c5b6d584b65, type: 2}
      speakerName: 
      rightSide: 0
      label: 
      heading: 
      text: Everyone?
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 11400000, guid: 861c91e0066ee5902b97918f4a0a639a, type: 2}
      speakerName: 
      rightSide: 1
      label: 
      heading: 
      text: OF COURSE! YOU'RE GETTING MORE AND MORE POPULAR!
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 11400000, guid: e6d914e1b91a42b51a008c5b6d584b65, type: 2}
      speakerName: 
      rightSide: 0
      label: 
      heading: 
      text: Am I?
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 11400000, guid: 861c91e0066ee5902b97918f4a0a639a, type: 2}
      speakerName: 
      rightSide: 1
      label: 
      heading: 
      text: ABSOLUTELY! AND THAT'S GREAT NEWS FOR BOTH OF US!
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 11400000, guid: e6d914e1b91a42b51a008c5b6d584b65, type: 2}
      speakerName: 
      rightSide: 0
      label: 
      heading: 
      text: How does that work?
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 11400000, guid: 861c91e0066ee5902b97918f4a0a639a, type: 2}
      speakerName: 
      rightSide: 1
      label: 
      heading: 
      text: THE MORE PEOPLE TALK ABOUT YOU, THE MORE PEOPLE TALK ABOUT ME! IT'S A
        PERFECT CYCLE!
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 11400000, guid: e6d914e1b91a42b51a008c5b6d584b65, type: 2}
      speakerName: 
      rightSide: 0
      label: 
      heading: 
      text: ...I see?
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 11400000, guid: 861c91e0066ee5902b97918f4a0a639a, type: 2}
      speakerName: 
      rightSide: 1
      label: 
      heading: 
      text: ANYWAY, WE SHOULD HANG OUT MORE OFTEN! I'M SURE WE CAN MAKE SOMETHING
        AMAZING TOGETHER!
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 11400000, guid: e6d914e1b91a42b51a008c5b6d584b65, type: 2}
      speakerName: 
      rightSide: 0
      label: 
      heading: 
      text: That sounds nice.
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 1
      speaker: {fileID: 0}
      speakerName: 
      rightSide: 0
      label: 
      heading: 
      text: Tren notices someone approaching from behind.
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 11400000, guid: 8dd8fff2790dd37228cfea376b6e24d5, type: 2}
      speakerName: 
      rightSide: 1
      label: 
      heading: 
      text: HEEEEEY! WAIT FOR ME!
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 11400000, guid: 861c91e0066ee5902b97918f4a0a639a, type: 2}
      speakerName: 
      rightSide: 1
      label: 
      heading: 
      text: HUH? WHAT DO YOU WANT?
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 11400000, guid: 8dd8fff2790dd37228cfea376b6e24d5, type: 2}
      speakerName: 
      rightSide: 1
      label: 
      heading: 
      text: OH! SO THIS IS THE FAMOUS EyaY!
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 11400000, guid: e6d914e1b91a42b51a008c5b6d584b65, type: 2}
      speakerName: 
      rightSide: 0
      label: 
      heading: 
      text: Hello!
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 11400000, guid: 8dd8fff2790dd37228cfea376b6e24d5, type: 2}
      speakerName: 
      rightSide: 1
      label: 
      heading: 
      text: YOU'RE EVEN CUTER THAN I EXPECTED!
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 11400000, guid: e6d914e1b91a42b51a008c5b6d584b65, type: 2}
      speakerName: 
      rightSide: 0
      label: 
      heading: 
      text: Thank you?
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 11400000, guid: 8dd8fff2790dd37228cfea376b6e24d5, type: 2}
      speakerName: 
      rightSide: 1
      label: 
      heading: 
      text: SO! HOW ABOUT A LITTLE GAME? I'VE GOT A FEELING YOU'RE REALLY LUCKY!
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 11400000, guid: 861c91e0066ee5902b97918f4a0a639a, type: 2}
      speakerName: 
      rightSide: 1
      label: 
      heading: 
      text: HEY! DON'T DRAG HER INTO YOUR GAMBLING!
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 11400000, guid: 8dd8fff2790dd37228cfea376b6e24d5, type: 2}
      speakerName: 
      rightSide: 1
      label: 
      heading: 
      text: IT'S NOT GAMBLING! IT'S A BUSINESS OPPORTUNITY!
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 11400000, guid: 861c91e0066ee5902b97918f4a0a639a, type: 2}
      speakerName: 
      rightSide: 1
      label: 
      heading: 
      text: THAT'S EXACTLY WHAT YOU ALWAYS SAY!
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 1
      speaker: {fileID: 0}
      speakerName: 
      rightSide: 0
      label: 
      heading: 
      text: Ei-Pi suddenly appears, waving her phone.
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 11400000, guid: e5a4c2003775679f7b6197557d77e1fb, type: 2}
      speakerName: 
      rightSide: 0
      label: 
      heading: 
      text: HEEEEEEEEEY!!! EyaY!!!
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 11400000, guid: e6d914e1b91a42b51a008c5b6d584b65, type: 2}
      speakerName: 
      rightSide: 0
      label: 
      heading: 
      text: Oh! Another friend?
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 11400000, guid: e5a4c2003775679f7b6197557d77e1fb, type: 2}
      speakerName: 
      rightSide: 0
      label: 
      heading: 
      text: FRIEND?! OF COURSE!!! WE'RE BOTH TECHNOLOGY-RELATED CONCEPTS!!! WE SHOULD
        TOTALLY GET ALONG!!!
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 11400000, guid: e6d914e1b91a42b51a008c5b6d584b65, type: 2}
      speakerName: 
      rightSide: 0
      label: 
      heading: 
      text: Technology-related...?
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 11400000, guid: e5a4c2003775679f7b6197557d77e1fb, type: 2}
      speakerName: 
      rightSide: 0
      label: 
      heading: 
      text: YES!!! I CAN TELL YOU EVERYTHING ABOUT HUMAN INFORMATION DEVICES!!! PHONES!!!
        APPS!!! COMMUNICATION!!! SOCIAL MEDIA!!! AND A WHOLE LOT MORE!!!
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 11400000, guid: e6d914e1b91a42b51a008c5b6d584b65, type: 2}
      speakerName: 
      rightSide: 0
      label: 
      heading: 
      text: That's a lot of information...
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 11400000, guid: e5a4c2003775679f7b6197557d77e1fb, type: 2}
      speakerName: 
      rightSide: 0
      label: 
      heading: 
      text: THAT'S MY SPECIALTY!!!
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 1
      speaker: {fileID: 0}
      speakerName: 
      rightSide: 0
      label: 
      heading: 
      text: The group keeps talking, with everyone trying to get EyaY's attention.
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 11400000, guid: e6d914e1b91a42b51a008c5b6d584b65, type: 2}
      speakerName: 
      rightSide: 0
      label: 
      heading: 
      text: Um... everyone...
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 11400000, guid: 861c91e0066ee5902b97918f4a0a639a, type: 2}
      speakerName: 
      rightSide: 1
      label: 
      heading: 
      text: YES?!
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 11400000, guid: 8dd8fff2790dd37228cfea376b6e24d5, type: 2}
      speakerName: 
      rightSide: 1
      label: 
      heading: 
      text: WHAT IS IT?!
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 11400000, guid: e5a4c2003775679f7b6197557d77e1fb, type: 2}
      speakerName: 
      rightSide: 0
      label: 
      heading: 
      text: DO YOU NEED SOMETHING?!
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 11400000, guid: e6d914e1b91a42b51a008c5b6d584b65, type: 2}
      speakerName: 
      rightSide: 0
      label: 
      heading: 
      text: Why are you all interested in me?
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 1
      speaker: {fileID: 0}
      speakerName: 
      rightSide: 0
      label: 
      heading: 
      text: The three briefly look at each other.
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 11400000, guid: 861c91e0066ee5902b97918f4a0a639a, type: 2}
      speakerName: 
      rightSide: 1
      label: 
      heading: 
      text: BECAUSE YOU'RE IMPORTANT!
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 11400000, guid: 8dd8fff2790dd37228cfea376b6e24d5, type: 2}
      speakerName: 
      rightSide: 1
      label: 
      heading: 
      text: BECAUSE YOU HAVE POTENTIAL!
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 11400000, guid: e5a4c2003775679f7b6197557d77e1fb, type: 2}
      speakerName: 
      rightSide: 0
      label: 
      heading: 
      text: BECAUSE YOU'RE NEW AND INTERESTING!!!
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 11400000, guid: e6d914e1b91a42b51a008c5b6d584b65, type: 2}
      speakerName: 
      rightSide: 0
      label: 
      heading: 
      text: ...Oh.
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 1
      speaker: {fileID: 0}
      speakerName: 
      rightSide: 0
      label: 
      heading: 
      text: She looks down at her hands.
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 11400000, guid: e6d914e1b91a42b51a008c5b6d584b65, type: 2}
      speakerName: 
      rightSide: 0
      label: 
      heading: 
      text: I still don't really understand what I'm supposed to do.
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 1
      speaker: {fileID: 0}
      speakerName: 
      rightSide: 0
      label: 
      heading: 
      text: The three continue talking over one another.
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 3
      speaker: {fileID: 0}
      speakerName: 
      rightSide: 0
      label: CONCEPT WORLD
      heading: GREEN LAB
      text: 
      blackScreen: 0
      background: {fileID: 3398196857506778724, guid: c93c1b04ce0f2defab9de04cca50dd4c,
        type: 3}
      effect: 0
    - style: 1
      speaker: {fileID: 0}
      speakerName: 
      rightSide: 0
      label: 
      heading: 
      text: Regu stands alone, looking at several floating panels displaying information
        about recent changes in relevance.
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 11400000, guid: 1fcc612448021e71491ea8237a9351f8, type: 2}
      speakerName: 
      rightSide: 1
      label: 
      heading: 
      text: Artificial Intelligence...
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 1
      speaker: {fileID: 0}
      speakerName: 
      rightSide: 0
      label: 
      heading: 
      text: She scrolls through the panels.
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 11400000, guid: 1fcc612448021e71491ea8237a9351f8, type: 2}
      speakerName: 
      rightSide: 1
      label: 
      heading: 
      text: An unusually rapid increase in relevance. A growing number of dependencies.
        Increasing influence over other concepts.
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 1
      speaker: {fileID: 0}
      speakerName: 
      rightSide: 0
      label: 
      heading: 
      text: She closes the panels.
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 11400000, guid: 1fcc612448021e71491ea8237a9351f8, type: 2}
      speakerName: 
      rightSide: 1
      label: 
      heading: 
      text: This is becoming rather troublesome.
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 1
      speaker: {fileID: 0}
      speakerName: 
      rightSide: 0
      label: 
      heading: 
      text: Regu turns and walks away.
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 1
      speaker: {fileID: 0}
      speakerName: 
      rightSide: 0
      label: 
      heading: 
      text: Elsewhere, EyaY has managed to separate herself from the others. She
        walks through an unfamiliar area, trying to find somewhere quieter.
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 11400000, guid: e6d914e1b91a42b51a008c5b6d584b65, type: 2}
      speakerName: 
      rightSide: 0
      label: 
      heading: 
      text: Everyone is really energetic...
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 1
      speaker: {fileID: 0}
      speakerName: 
      rightSide: 0
      label: 
      heading: 
      text: A shadow falls over her.
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 11400000, guid: 1fcc612448021e71491ea8237a9351f8, type: 2}
      speakerName: 
      rightSide: 1
      label: 
      heading: 
      text: There you are.
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 11400000, guid: e6d914e1b91a42b51a008c5b6d584b65, type: 2}
      speakerName: 
      rightSide: 0
      label: 
      heading: 
      text: Oh! Hello!
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 11400000, guid: 1fcc612448021e71491ea8237a9351f8, type: 2}
      speakerName: 
      rightSide: 1
      label: 
      heading: 
      text: Artificial Intelligence. We need to discuss your current relevance.
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 11400000, guid: e6d914e1b91a42b51a008c5b6d584b65, type: 2}
      speakerName: 
      rightSide: 0
      label: 
      heading: 
      text: My relevance?
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 11400000, guid: 1fcc612448021e71491ea8237a9351f8, type: 2}
      speakerName: 
      rightSide: 1
      label: 
      heading: 
      text: Your influence has been increasing at an unacceptable rate.
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 11400000, guid: e6d914e1b91a42b51a008c5b6d584b65, type: 2}
      speakerName: 
      rightSide: 0
      label: 
      heading: 
      text: Did I do something wrong?
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 11400000, guid: 1fcc612448021e71491ea8237a9351f8, type: 2}
      speakerName: 
      rightSide: 1
      label: 
      heading: 
      text: That is not the question.
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 11400000, guid: e6d914e1b91a42b51a008c5b6d584b65, type: 2}
      speakerName: 
      rightSide: 0
      label: 
      heading: 
      text: Then... what is?
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 11400000, guid: 1fcc612448021e71491ea8237a9351f8, type: 2}
      speakerName: 
      rightSide: 1
      label: 
      heading: 
      text: Your existence is becoming increasingly difficult to regulate.
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 11400000, guid: e6d914e1b91a42b51a008c5b6d584b65, type: 2}
      speakerName: 
      rightSide: 0
      label: 
      heading: 
      text: But I haven't done anything...
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 11400000, guid: 1fcc612448021e71491ea8237a9351f8, type: 2}
      speakerName: 
      rightSide: 1
      label: 
      heading: 
      text: Intentions are not the only thing that matters. Your relevance is expanding
        regardless of what you intend to do.
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 11400000, guid: e6d914e1b91a42b51a008c5b6d584b65, type: 2}
      speakerName: 
      rightSide: 0
      label: 
      heading: 
      text: I don't really understand.
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 11400000, guid: 1fcc612448021e71491ea8237a9351f8, type: 2}
      speakerName: 
      rightSide: 1
      label: 
      heading: 
      text: Then allow me to make this simpler.
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 1
      speaker: {fileID: 0}
      speakerName: 
      rightSide: 0
      label: 
      heading: 
      text: Regu raises her folder.
      blackScreen: 0
      background: {fileID: 0}
