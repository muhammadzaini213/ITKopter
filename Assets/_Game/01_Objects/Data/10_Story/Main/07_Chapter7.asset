  - time: 0.4
    speaker: {fileID: 11400000, guid: f84f736e81305891196beccef0305ec9, type: 2}
    speakerName: 
    text: Spare Dust and Engrams can be converted here too. Very good business.
    duration: 5
  - time: 0.4
