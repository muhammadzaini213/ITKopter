  segments:
  - type: 0
    lines:
    - style: 1
      speaker: {fileID: 0}
      speakerName: 
      rightSide: 0
      label: 
      heading: 
      text: Ei-Pi immediately starts talking at an unreasonable speed.
      blackScreen: 0
      effect: 0
    - style: 0
      speaker: {fileID: 11400000, guid: e5a4c2003775679f7b6197557d77e1fb, type: 2}
      speakerName: 
      rightSide: 0
      label: 
      heading: 
      text: HEEEEEEEEEEEEEEEEY!!! NEW KING!!! FINALLYYYYY!!! I'M EIPI!!! YOUR HANDHELD
        INFORMATION DEVICE!!! YOU KNOW HOW TO USE A PHONE RIGHT??? OF COURSE YOU
        DO!!!
      blackScreen: 0
      effect: 0
    - style: 0
      speaker: {fileID: 11400000, guid: e5a4c2003775679f7b6197557d77e1fb, type: 2}
      speakerName: 
      rightSide: 0
      label: 
      heading: 
      text: OKAYLISTENCAREFULLY!!! YOU CAN MOVE USING THE LEFT STICK AND ATTACK USING
        THE ATTACK BUTTON!!! SUPER SIMPLE!!!
      blackScreen: 0
      effect: 0
    - style: 0
      speaker: {fileID: 11400000, guid: e5a4c2003775679f7b6197557d77e1fb, type: 2}
      speakerName: 
      rightSide: 0
      label: 
      heading: 
      text: NOW LOOK OVER THERE!!! THAT'S ANON!!! HE'S THE BLACK ONE!!! NO NOT THAT
        BLACK ONE!!! THE OTHER BLACK ONE!!! JUST SHOOT HIM!!! PROBABLY!!!
      blackScreen: 0
      effect: 0
    - style: 0
      speaker: {fileID: 0}
      speakerName: Fajar
      rightSide: 0
      label: 
      heading: 
      text: ...What are you talking about?
      blackScreen: 0
      effect: 0
    - style: 0
      speaker: {fileID: 11400000, guid: e5a4c2003775679f7b6197557d77e1fb, type: 2}
      speakerName: 
      rightSide: 0
      label: 
      heading: 
      text: DON'T WORRY!!! I'LL EXPLAIN EVERYTHING WHILE WE'RE MOVING!!!
      blackScreen: 0
      effect: 0
    - style: 1
      speaker: {fileID: 0}
      speakerName: 
      rightSide: 0
      label: 
      heading: 
      text: Anon notices Fajar and Ei-Pi looking at him.
      blackScreen: 0
      effect: 0
    - style: 0
      speaker: {fileID: 11400000, guid: c56d01f7147e2fe3bb19ffecd321267b, type: 2}
      speakerName: 
      rightSide: 1
      label: 
      heading: 
      text: Huh? Wait... why are you looking at me?
      blackScreen: 0
      effect: 0
    - style: 0
      speaker: {fileID: 11400000, guid: c56d01f7147e2fe3bb19ffecd321267b, type: 2}
      speakerName: 
      rightSide: 1
      label: 
      heading: 
      text: I JUST ESCAPED AFTER GETTING BEATEN UP BY SAINZ AND NAWLEG! CAN'T I HAVE
        A BREAK?!
      blackScreen: 0
      effect: 0
    - style: 0
      speaker: {fileID: 11400000, guid: e5a4c2003775679f7b6197557d77e1fb, type: 2}
      speakerName: 
      rightSide: 0
      label: 
      heading: 
      text: OH!!! PERFECT!!! YOU'RE ALREADY WARMED UP!!!
      blackScreen: 0
      effect: 0
    - style: 0
      speaker: {fileID: 11400000, guid: c56d01f7147e2fe3bb19ffecd321267b, type: 2}
      speakerName: 
      rightSide: 1
      label: 
      heading: 
      text: THAT'S NOT WHAT THAT MEANS!!!
      blackScreen: 0
      effect: 0
