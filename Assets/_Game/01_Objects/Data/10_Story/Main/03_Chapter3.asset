      duration: 4.5
    - time: 8
      speaker: {fileID: 11400000, guid: e5a4c2003775679f7b6197557d77e1fb, type: 2}
      speakerName: 
      text: YOU SHOOT ALL BY YOURSELF!!! JUST STAY IN FRONT OF THEM!!!
      duration: 4.5
    - time: 16
      speaker: {fileID: 11400000, guid: e5a4c2003775679f7b6197557d77e1fb, type: 2}
      speakerName: 
      text: SEE THOSE BULLETS??? DON'T TOUCH THEM!!! SLIP THROUGH THE GAPS!!!
      duration: 4.5
    - time: 26
      speaker: {fileID: 11400000, guid: e5a4c2003775679f7b6197557d77e1fb, type: 2}
      speakerName: 
      text: WHEN MY EX SKILL IS READY, PRESS K!!! DO IT!!! DO IT NOW!!!
      duration: 4.5
    - time: 48
      speaker: {fileID: 11400000, guid: c56d01f7147e2fe3bb19ffecd321267b, type: 2}
      speakerName: 
      text: STOP SHOOTING AT ME!!! I'M INJURED!!!
      duration: 4.5
