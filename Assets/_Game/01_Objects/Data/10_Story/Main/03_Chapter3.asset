  m_Name: 03_Chapter3
  m_EditorClassIdentifier: Assembly-CSharp::StoryData
  storyId: story_main_03
  storyName: The Loudest Thing in the Room
  storyDescription: 'Battle: Ei-Pi vs. Anon. Reward: Ei-Pi joins the roster.'
  chapterLabel: CHAPTER 3
  previousStory: {fileID: 11400000, guid: 47b7920ce3ed0536288f9dc6be308054, type: 2}
  requiredLevel: {fileID: 0}
  storyPrefab: {fileID: 0}
  segments:
  - type: 0
    lines:
    - style: 1
      speaker: {fileID: 0}
      speakerName: 
      rightSide: 0
      label: 
      heading: 
      text: A small figure approaches Fajar at incredible speed.
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 11400000, guid: e5a4c2003775679f7b6197557d77e1fb, type: 2}
      speakerName: 
      rightSide: 0
      label: 
      heading: 
      text: HEEEEEEEEEEEEEEEEY!!! NEW KING!!! FINALLYYYY!!!
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 0}
      speakerName: Fajar
      rightSide: 0
      label: 
      heading: 
      text: ...What?
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 11400000, guid: e5a4c2003775679f7b6197557d77e1fb, type: 2}
      speakerName: 
      rightSide: 0
      label: 
      heading: 
      text: I'M EIPI!!! YOUR HANDHELD INFORMATION DEVICE!!!
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 0}
      speakerName: Fajar
      rightSide: 0
      label: 
      heading: 
      text: Handheld what?
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 11400000, guid: e5a4c2003775679f7b6197557d77e1fb, type: 2}
      speakerName: 
      rightSide: 0
      label: 
      heading: 
      text: YOU KNOW HOW TO USE A PHONE RIGHT???
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 0}
      speakerName: Fajar
      rightSide: 0
      label: 
      heading: 
      text: I mean, yes?
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 11400000, guid: e5a4c2003775679f7b6197557d77e1fb, type: 2}
      speakerName: 
      rightSide: 0
      label: 
      heading: 
      text: GREAT!!! THAT'S ALL I NEED!!!
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 0}
      speakerName: Fajar
      rightSide: 0
      label: 
      heading: 
      text: That's all you need for what?
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 11400000, guid: e5a4c2003775679f7b6197557d77e1fb, type: 2}
      speakerName: 
      rightSide: 0
      label: 
      heading: 
      text: TO HELP YOU SURVIVE!!! OBVIOUSLY!!!
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 1
      speaker: {fileID: 0}
      speakerName: 
      rightSide: 0
      label: 
      heading: 
      text: Ei-Pi circles around Fajar.
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 11400000, guid: e5a4c2003775679f7b6197557d77e1fb, type: 2}
      speakerName: 
      rightSide: 0
      label: 
      heading: 
      text: OKAY!!! FIRST, YOU NEED TO KNOW HOW TO MOVE!!!
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 11400000, guid: e5a4c2003775679f7b6197557d77e1fb, type: 2}
      speakerName: 
      rightSide: 0
      label: 
      heading: 
      text: YOU CAN MOVE USING THE LEFT STICK!!!
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 0}
      speakerName: Fajar
      rightSide: 0
      label: 
      heading: 
      text: ...Okay.
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 11400000, guid: e5a4c2003775679f7b6197557d77e1fb, type: 2}
      speakerName: 
      rightSide: 0
      label: 
      heading: 
      text: AND YOU ATTACK USING THE ATTACK BUTTON!!!
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 0}
      speakerName: Fajar
      rightSide: 0
      label: 
      heading: 
      text: Wait, attack who?
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 11400000, guid: e5a4c2003775679f7b6197557d77e1fb, type: 2}
      speakerName: 
      rightSide: 0
      label: 
      heading: 
      text: THAT'S ANON!!!
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 1
      speaker: {fileID: 0}
      speakerName: 
      rightSide: 0
      label: 
      heading: 
      text: Ei-Pi points toward a black silhouette standing a short distance away.
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 11400000, guid: e5a4c2003775679f7b6197557d77e1fb, type: 2}
      speakerName: 
      rightSide: 0
      label: 
      heading: 
      text: HE'S THE BLACK ONE!!! NO NOT THAT BLACK ONE!!! THE OTHER BLACK ONE!!!
        JUST SHOOT HIM!!! PROBABLY!!!
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 0}
      speakerName: Fajar
      rightSide: 0
      label: 
      heading: 
      text: ...What are you talking about?
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 11400000, guid: e5a4c2003775679f7b6197557d77e1fb, type: 2}
      speakerName: 
      rightSide: 0
      label: 
      heading: 
      text: I'LL EXPLAIN EVERYTHING WHILE WE'RE MOVING!!!
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 0}
      speakerName: Fajar
      rightSide: 0
      label: 
      heading: 
      text: That's not how explaining works!
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 1
      speaker: {fileID: 0}
      speakerName: 
      rightSide: 0
      label: 
      heading: 
      text: The black silhouette notices them.
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 11400000, guid: c56d01f7147e2fe3bb19ffecd321267b, type: 2}
      speakerName: 
      rightSide: 1
      label: 
      heading: 
      text: Huh?
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 1
      speaker: {fileID: 0}
      speakerName: 
      rightSide: 0
      label: 
      heading: 
      text: Anon looks behind himself.
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 11400000, guid: c56d01f7147e2fe3bb19ffecd321267b, type: 2}
      speakerName: 
      rightSide: 1
      label: 
      heading: 
      text: Wait... why are you looking at me?
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 11400000, guid: e5a4c2003775679f7b6197557d77e1fb, type: 2}
      speakerName: 
      rightSide: 0
      label: 
      heading: 
      text: HEY ANON!!!
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 11400000, guid: c56d01f7147e2fe3bb19ffecd321267b, type: 2}
      speakerName: 
      rightSide: 1
      label: 
      heading: 
      text: ...No.
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 11400000, guid: e5a4c2003775679f7b6197557d77e1fb, type: 2}
      speakerName: 
      rightSide: 0
      label: 
      heading: 
      text: COME HERE!!!
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 11400000, guid: c56d01f7147e2fe3bb19ffecd321267b, type: 2}
      speakerName: 
      rightSide: 1
      label: 
      heading: 
      text: NO!!!
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 11400000, guid: e5a4c2003775679f7b6197557d77e1fb, type: 2}
      speakerName: 
      rightSide: 0
      label: 
      heading: 
      text: WE HAVE A NEW KING!!!
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 11400000, guid: c56d01f7147e2fe3bb19ffecd321267b, type: 2}
      speakerName: 
      rightSide: 1
      label: 
      heading: 
      text: GOOD FOR YOU?!
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 11400000, guid: e5a4c2003775679f7b6197557d77e1fb, type: 2}
      speakerName: 
      rightSide: 0
      label: 
      heading: 
      text: HE NEEDS A TARGET!!!
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 11400000, guid: c56d01f7147e2fe3bb19ffecd321267b, type: 2}
      speakerName: 
      rightSide: 1
      label: 
      heading: 
      text: WHAT?!
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 0}
      speakerName: Fajar
      rightSide: 0
      label: 
      heading: 
      text: Hold on. Why are we fighting him?
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 11400000, guid: e5a4c2003775679f7b6197557d77e1fb, type: 2}
      speakerName: 
      rightSide: 0
      label: 
      heading: 
      text: DON'T WORRY ABOUT IT!!! HE'S FINE!!! PROBABLY!!!
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 11400000, guid: c56d01f7147e2fe3bb19ffecd321267b, type: 2}
      speakerName: 
      rightSide: 1
      label: 
      heading: 
      text: I'M RIGHT HERE!!!
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 11400000, guid: c56d01f7147e2fe3bb19ffecd321267b, type: 2}
      speakerName: 
      rightSide: 1
      label: 
      heading: 
      text: I JUST ESCAPED AFTER GETTING BEATEN UP BY SAINZ AND NAWLEG! CAN'T I HAVE
        A BREAK?!
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 11400000, guid: e5a4c2003775679f7b6197557d77e1fb, type: 2}
      speakerName: 
      rightSide: 0
      label: 
      heading: 
      text: PERFECT!!! YOU'RE ALREADY WARMED UP!!!
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 11400000, guid: c56d01f7147e2fe3bb19ffecd321267b, type: 2}
      speakerName: 
      rightSide: 1
      label: 
      heading: 
      text: THAT'S NOT WHAT THAT MEANS!!!
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 0}
      speakerName: Fajar
      rightSide: 0
      label: 
      heading: 
      text: ...Is everyone here like this?
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 11400000, guid: e5a4c2003775679f7b6197557d77e1fb, type: 2}
      speakerName: 
      rightSide: 0
      label: 
      heading: 
      text: PRETTY MUCH!!!
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    level: {fileID: 0}
    team: []
    scriptedLoss: 0
    scriptedLossSeconds: 45
    battleToasts: []
