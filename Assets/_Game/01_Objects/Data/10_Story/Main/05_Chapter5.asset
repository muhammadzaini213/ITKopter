    battleToasts:
    - time: 2
      speaker: {fileID: 11400000, guid: e5a4c2003775679f7b6197557d77e1fb, type: 2}
      speakerName: 
      text: THEY'RE STRONG!!! LIKE, REALLY STRONG!!! JUST SURVIVE!!!
      duration: 4.5
    - time: 13
      speaker: {fileID: 11400000, guid: 861c91e0066ee5902b97918f4a0a639a, type: 2}
      speakerName: 
      text: Awww, is that all you've got?
      duration: 4.5
    - time: 27
      speaker: {fileID: 11400000, guid: f84f736e81305891196beccef0305ec9, type: 2}
      speakerName: 
      text: Oh my, what a disappointing performance. I expected a little more from
        the new King.
      duration: 5.5
  - type: 0
    lines:
    - style: 1
      speaker: {fileID: 0}
      speakerName: 
      rightSide: 0
      label: 
      heading: 
      text: The battle is lost.
      blackScreen: 0
      effect: 0
    - style: 1
      speaker: {fileID: 0}
      speakerName: 
      rightSide: 0
      label: 
      heading: 
      text: After the battle, Bokusu appears and introduces himself as a Protector.
      blackScreen: 0
      effect: 0
    - style: 0
      speaker: {fileID: 11400000, guid: 2427568e74d898eb2a009073ab81c9c4, type: 2}
      speakerName: 
      rightSide: 0
      label: 
      heading: 
      text: ...You look like you could use a shield.
      blackScreen: 0
      effect: 0
    - style: 0
      speaker: {fileID: 11400000, guid: e5a4c2003775679f7b6197557d77e1fb, type: 2}
      speakerName: 
      rightSide: 0
      label: 
      heading: 
      text: FINALLY!!! SOMEONE WHO CAN KEEP US ALIVE!!!
      blackScreen: 0
      effect: 0
    - style: 0
      speaker: {fileID: 11400000, guid: 2427568e74d898eb2a009073ab81c9c4, type: 2}
      speakerName: 
      rightSide: 0
      label: 
      heading: 
      text: That's... technically my job.
      blackScreen: 0
      effect: 0
    - style: 1
      speaker: {fileID: 0}
      speakerName: 
      rightSide: 0
      label: 
      heading: 
      text: Fajar gets another chance to fight Tren and Trady, now with Bokusu in
        the party.
      blackScreen: 0
      effect: 0
