    battleToasts:
    - time: 1.5
      speaker: {fileID: 11400000, guid: 2427568e74d898eb2a009073ab81c9c4, type: 2}
      speakerName: 
      text: Press 3 to bring me in when the bullets get thick. Taking hits is my
        job.
      duration: 4.5
    - time: 10
      speaker: {fileID: 11400000, guid: 2427568e74d898eb2a009073ab81c9c4, type: 2}
      speakerName: 
      text: 'Press K for my EX skill: a barrier that blocks enemy fire for a few
        seconds.'
      duration: 4.5
    - time: 20
      speaker: {fileID: 11400000, guid: 2427568e74d898eb2a009073ab81c9c4, type: 2}
      speakerName: 
      text: Keep whoever is on the field alive. Swap them out before they fall.
      duration: 4.5
    - time: 30
      speaker: {fileID: 11400000, guid: e5a4c2003775679f7b6197557d77e1fb, type: 2}
      speakerName: 
      text: STILL LOSING!!! BUT LOSING SLOWER!!! PROGRESS!!!
      duration: 4.5
    - time: 38
      speaker: {fileID: 11400000, guid: f84f736e81305891196beccef0305ec9, type: 2}
      speakerName: 
      text: Diversifying your portfolio won't save you, dear.
      duration: 4.5
  - type: 0
    lines:
    - style: 1
      speaker: {fileID: 0}
      speakerName: 
      rightSide: 0
      label: 
      heading: 
      text: The battle is lost again.
      blackScreen: 0
      effect: 0
    - style: 0
      speaker: {fileID: 0}
      speakerName: Fajar
      rightSide: 0
      label: 
      heading: 
      text: ...We lost twice.
      blackScreen: 0
      effect: 0
    - style: 0
      speaker: {fileID: 11400000, guid: f030c5b604997dacfaea867d37529fce, type: 2}
      speakerName: 
      rightSide: 0
      label: 
      heading: 
      text: At least we learned something.
      blackScreen: 0
      effect: 0
    - style: 0
      speaker: {fileID: 11400000, guid: e5a4c2003775679f7b6197557d77e1fb, type: 2}
      speakerName: 
      rightSide: 0
      label: 
      heading: 
      text: I LEARNED THAT THEY'RE REALLY ANNOYING!!!
      blackScreen: 0
      effect: 0
    - style: 0
      speaker: {fileID: 11400000, guid: f84f736e81305891196beccef0305ec9, type: 2}
      speakerName: 
      rightSide: 1
      label: 
      heading: 
      text: Aww, don't look so disappointed. Losing is just another opportunity to
        make a better investment!
      blackScreen: 0
      effect: 0
