  - type: 0
    lines:
    - style: 1
      speaker: {fileID: 0}
      speakerName: 
      rightSide: 0
      label: 
      heading: 
      text: Majik is weakened but still standing.
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 11400000, guid: d1990186088358f7cadaff080739aeb2, type: 2}
      speakerName: 
      rightSide: 1
      label: 
      heading: 
      text: URGH...! THAT WAS... INCREDIBLE!
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 0}
      speakerName: Fajar
      rightSide: 0
      label: 
      heading: 
      text: You're still trying to protect her?
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 11400000, guid: d1990186088358f7cadaff080739aeb2, type: 2}
      speakerName: 
      rightSide: 1
      label: 
      heading: 
      text: OF COURSE! I SAID I WOULD!
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 11400000, guid: e6d914e1b91a42b51a008c5b6d584b65, type: 2}
      speakerName: 
      rightSide: 1
      label: 
      heading: 
      text: Majik...
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 11400000, guid: d1990186088358f7cadaff080739aeb2, type: 2}
      speakerName: 
      rightSide: 1
      label: 
      heading: 
      text: STAY BACK! I'VE GOT THIS!
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 1
      speaker: {fileID: 0}
      speakerName: 
      rightSide: 0
      label: 
      heading: 
      text: Fajar turns toward EyaY.
      blackScreen: 0
      background: {fileID: 0}
      effect: 0
    - style: 0
      speaker: {fileID: 0}
      speakerName: Fajar
      rightSide: 0
      label: 
      heading: 
      text: Alright. Let's get this over with.
      blackScreen: 0
      background: {fileID: 0}
